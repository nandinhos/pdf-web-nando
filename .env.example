# === Limites de upload (PRD §9) ===
MAX_FILE_SIZE_MB=500
MAX_PAGES_PER_OP=2000

# === Artefatos temporários (TTL) ===
ARTIFACT_TTL_MINUTES=60

# === Storage (MinIO / S3) ===
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=pdfweb
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# === Redis (jobs) ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=/api/v1

# === Porta HTTP publicada pelo nginx (host) ===
# 8080 pode conflitar com outros serviços locais; padrão 8090.
HTTP_PORT=8090
